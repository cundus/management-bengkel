# ── Database (wajib) ─────────────────────────────────────────────
# PostgreSQL. Untuk Vercel + Neon/Vercel Postgres, gunakan koneksi POOLED.
DATABASE_URL=postgresql://user:password@host:5432/wmc225?schema=public
# Koneksi langsung (non-pooled) untuk Prisma Migrate.
DIRECT_URL=postgresql://user:password@host:5432/wmc225?schema=public

# ── Auth ─────────────────────────────────────────────────────────
# Secret penandatangan session cookie, minimal 32 karakter acak.
AUTH_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# ── Opsional ─────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Jakarta
# NEXT_PUBLIC_APP_URL=https://wmc225.vercel.app

# Database khusus test lokal (docker compose menyediakannya).
E2E_DATABASE_URL=postgresql://wmc:wmc@localhost:5432/wmc225_e2e?schema=public
TEST_DATABASE_URL=postgresql://wmc:wmc@localhost:5432/wmc225_test?schema=public
