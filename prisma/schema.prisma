// Prisma schema for WMC 225.
// Production: set DATABASE_URL (pooled) and DIRECT_URL (direct) to your Postgres provider.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  owner
  kasir
}

enum ItemCategory {
  jasa
  sparepart
}

enum PaymentMethod {
  tunai
  transfer
  qris
}

enum TransactionStatus {
  selesai
  batal
}

enum VoidRequestStatus {
  pending
  disetujui
  ditolak
}

// Arah ditentukan oleh tanda qty: positif masuk, negatif keluar.
enum StockMovementType {
  saldo_awal
  penerimaan
  pembelian
  penjualan
  pembatalan
  penyesuaian
}

enum StockAdjustmentReason {
  rusak
  hilang
  kedaluwarsa
  pemakaian_internal
  ditemukan
  salah_catat
  lainnya
}

model User {
  id                   Int               @id @default(autoincrement())
  name                 String
  email                String            @unique
  username             String?           @unique
  passwordHash         String            @map("password_hash")
  role                 UserRole
  createdAt            DateTime          @default(now()) @map("created_at")
  transactions         Transaction[]     @relation("TransactionCreator")
  payments             Payment[]         @relation("PaymentReceiver")
  expenses             Expense[]         @relation("ExpenseCreator")
  payables             Payable[]         @relation("PayableCreator")
  payablePayments      PayablePayment[]  @relation("PayablePaymentCreator")
  purchases            Purchase[]
  stockMovements       StockMovement[]
  stockAdjustments     StockAdjustment[]
  voidedTransactions   Transaction[]     @relation("TransactionVoider")
  refunds              Refund[]          @relation("RefundCreator")
  voidRequests         VoidRequest[]     @relation("VoidRequester")
  reviewedVoidRequests VoidRequest[]     @relation("VoidReviewer")

  @@map("users")
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  vehicles     Vehicle[]
  transactions Transaction[]

  @@index([name])
  @@map("customers")
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  customerId   Int           @map("customer_id")
  plateNumber  String        @map("plate_number")
  brand        String
  model        String
  year         Int?
  color        String?
  odometer     Int?
  createdAt    DateTime      @default(now()) @map("created_at")
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([customerId])
  @@index([plateNumber])
  @@map("vehicles")
}

model Item {
  id               Int               @id @default(autoincrement())
  sku              String            @unique
  name             String
  category         ItemCategory
  unit             String            @default("pcs")
  price            Int
  cost             Int               @default(0)
  stock            Int               @default(0)
  minStock         Int               @default(0) @map("min_stock")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  transactionItems TransactionItem[]
  stockBatches     StockBatch[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]

  @@index([category])
  @@map("items")
}

model Transaction {
  id             String            @id @default(uuid())
  invoiceNo      String            @unique @map("invoice_no")
  customerId     Int               @map("customer_id")
  vehicleId      Int?              @map("vehicle_id")
  mechanic       String?
  subtotal       Int
  discount       Int               @default(0)
  total          Int
  businessDate   DateTime          @map("business_date") @db.Date
  dueDate        DateTime?         @map("due_date") @db.Date
  notes          String?
  status         TransactionStatus @default(selesai)
  createdById    Int               @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  voidedAt       DateTime?         @map("voided_at")
  voidReason     String?           @map("void_reason")
  // Tanggal bisnis pembatalan; pendapatan pembatalan (bayar − refund) diakui di tanggal ini.
  voidedDate     DateTime?         @map("voided_date") @db.Date
  voidedById     Int?              @map("voided_by")
  voidedBy       User?             @relation("TransactionVoider", fields: [voidedById], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id])
  createdBy      User              @relation("TransactionCreator", fields: [createdById], references: [id])
  items          TransactionItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  refunds        Refund[]
  voidRequests   VoidRequest[]

  @@index([businessDate])
  @@index([customerId])
  @@index([voidedDate])
  @@index([dueDate])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            Int          @id @default(autoincrement())
  transactionId String       @map("transaction_id")
  itemId        Int?         @map("item_id")
  name          String
  category      ItemCategory
  qty           Int
  unitPrice     Int          @map("unit_price")
  unitCost      Int          @default(0) @map("unit_cost")
  subtotal      Int
  stockBatchId  Int?         @map("stock_batch_id")
  stockBatch    StockBatch?  @relation(fields: [stockBatchId], references: [id])
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([stockBatchId])
  @@map("transaction_items")
}

model StockBatch {
  id               Int               @id @default(autoincrement())
  itemId           Int               @map("item_id")
  code             String
  receivedDate     DateTime          @map("received_date") @db.Date
  quantity         Int
  remaining        Int
  unitCost         Int               @map("unit_cost")
  notes            String?
  purchaseId       Int?              @map("purchase_id")
  purchase         Purchase?         @relation(fields: [purchaseId], references: [id])
  createdAt        DateTime          @default(now()) @map("created_at")
  item             Item              @relation(fields: [itemId], references: [id])
  transactionItems TransactionItem[]
  stockMovements   StockMovement[]

  @@unique([itemId, code])
  @@index([purchaseId])
  @@index([itemId, receivedDate, id])
  @@map("stock_batches")
}

// Ledger stok append-only. Setiap perubahan items.stock menulis satu baris atau lebih
// di transaksi database yang sama; jumlah qty per item selalu sama dengan items.stock.
model StockMovement {
  id                Int               @id @default(autoincrement())
  itemId            Int               @map("item_id")
  stockBatchId      Int?              @map("stock_batch_id")
  type              StockMovementType
  qty               Int
  balanceAfter      Int               @map("balance_after")
  transactionId     String?           @map("transaction_id")
  purchaseId        Int?              @map("purchase_id")
  stockAdjustmentId Int?              @map("stock_adjustment_id")
  notes             String?
  createdById       Int?              @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  item              Item              @relation(fields: [itemId], references: [id])
  stockBatch        StockBatch?       @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  transaction       Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  purchase          Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  stockAdjustment   StockAdjustment?  @relation(fields: [stockAdjustmentId], references: [id], onDelete: Restrict)
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([itemId, id])
  @@index([stockBatchId])
  @@index([transactionId])
  @@index([purchaseId])
  @@index([stockAdjustmentId])
  @@index([createdAt])
  @@map("stock_movements")
}

// Penyesuaian stok manual (append-only). Koreksi dilakukan dengan penyesuaian baru,
// bukan edit/hapus. qty dan value bertanda: negatif = stok/nilai berkurang.
model StockAdjustment {
  id             Int                   @id @default(autoincrement())
  itemId         Int                   @map("item_id")
  reason         StockAdjustmentReason
  qty            Int
  stockBefore    Int                   @map("stock_before")
  stockAfter     Int                   @map("stock_after")
  // Nilai persediaan yang berubah, dihitung dari modal batch yang terdampak.
  value          Int
  notes          String
  businessDate   DateTime              @map("business_date") @db.Date
  createdById    Int                   @map("created_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  item           Item                  @relation(fields: [itemId], references: [id])
  createdBy      User                  @relation(fields: [createdById], references: [id])
  stockMovements StockMovement[]

  @@index([itemId, id])
  @@index([businessDate])
  @@map("stock_adjustments")
}

model Payment {
  id                Int           @id @default(autoincrement())
  transactionId     String        @map("transaction_id")
  amount            Int
  method            PaymentMethod
  notes             String?
  businessDate      DateTime      @map("business_date") @db.Date
  paidAt            DateTime      @default(now()) @map("paid_at")
  receivedById      Int           @map("received_by")
  /// Diisi pada entri koreksi (nominal negatif) yang membalik pembayaran lain. Pembayaran
  /// tidak pernah diubah/dihapus; salah input dikoreksi dengan entri pembalik.
  reversesPaymentId Int?          @unique @map("reverses_payment_id")
  transaction       Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receivedBy        User          @relation("PaymentReceiver", fields: [receivedById], references: [id])
  reverses          Payment?      @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: NoAction)
  reversal          Payment?      @relation("PaymentReversal")

  @@index([transactionId])
  @@index([businessDate])
  @@map("payments")
}

// Uang yang dikembalikan ke pelanggan saat nota dibatalkan. Pembayaran asli tidak dihapus
// agar kas hari pembayaran tetap; refund menjadi kas keluar di tanggal bisnisnya.
model Refund {
  id            Int           @id @default(autoincrement())
  transactionId String        @map("transaction_id")
  amount        Int
  method        PaymentMethod
  notes         String?
  businessDate  DateTime      @map("business_date") @db.Date
  refundedAt    DateTime      @default(now()) @map("refunded_at")
  createdById   Int           @map("created_by")
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("RefundCreator", fields: [createdById], references: [id])

  @@index([transactionId])
  @@index([businessDate])
  @@map("refunds")
}

// Pengajuan pembatalan oleh kasir; pemilik menyetujui (menjalankan pembatalan) atau menolak.
model VoidRequest {
  id            Int               @id @default(autoincrement())
  transactionId String            @map("transaction_id")
  reason        String
  status        VoidRequestStatus @default(pending)
  requestedById Int               @map("requested_by")
  requestedAt   DateTime          @default(now()) @map("requested_at")
  reviewedById  Int?              @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNote    String?           @map("review_note")
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("VoidRequester", fields: [requestedById], references: [id])
  reviewedBy    User?             @relation("VoidReviewer", fields: [reviewedById], references: [id])

  @@index([transactionId])
  @@index([status])
  @@map("void_requests")
}

model Expense {
  id          Int      @id @default(autoincrement())
  expenseDate DateTime @map("expense_date") @db.Date
  category    String
  description String
  amount      Int
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   User     @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([expenseDate])
  @@map("expenses")
}

model Supplier {
  id            Int        @id @default(autoincrement())
  name          String
  contactPerson String?    @map("contact_person")
  phone         String?
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  payables      Payable[]
  purchases     Purchase[]

  @@map("suppliers")
}

model Payable {
  id           Int              @id @default(autoincrement())
  supplierId   Int              @map("supplier_id")
  referenceNo  String?          @map("reference_no")
  description  String
  amount       Int
  businessDate DateTime         @map("business_date") @db.Date
  dueDate      DateTime?        @map("due_date") @db.Date
  createdAt    DateTime         @default(now()) @map("created_at")
  createdById  Int              @map("created_by")
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  createdBy    User             @relation("PayableCreator", fields: [createdById], references: [id])
  payments     PayablePayment[]
  purchase     Purchase?

  @@index([dueDate])
  @@map("payables")
}

model Purchase {
  id             Int             @id @default(autoincrement())
  requestId      String          @unique @map("request_id") @db.Uuid
  supplierId     Int             @map("supplier_id")
  referenceNo    String?         @map("reference_no")
  businessDate   DateTime        @map("business_date") @db.Date
  total          Int
  notes          String?
  payableId      Int             @unique @map("payable_id")
  createdById    Int             @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  payable        Payable         @relation(fields: [payableId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])
  batches        StockBatch[]
  stockMovements StockMovement[]

  @@unique([supplierId, referenceNo])
  @@index([businessDate])
  @@map("purchases")
}

model PayablePayment {
  id                Int             @id @default(autoincrement())
  payableId         Int             @map("payable_id")
  amount            Int
  method            PaymentMethod
  notes             String?
  businessDate      DateTime        @map("business_date") @db.Date
  paidAt            DateTime        @default(now()) @map("paid_at")
  paidById          Int             @map("paid_by")
  /// Entri koreksi (nominal negatif) yang membalik pembayaran hutang lain.
  reversesPaymentId Int?            @unique @map("reverses_payment_id")
  payable           Payable         @relation(fields: [payableId], references: [id], onDelete: Cascade)
  paidBy            User            @relation("PayablePaymentCreator", fields: [paidById], references: [id])
  reverses          PayablePayment? @relation("PayablePaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: NoAction)
  reversal          PayablePayment? @relation("PayablePaymentReversal")

  @@index([payableId])
  @@map("payable_payments")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}
