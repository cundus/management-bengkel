// Prisma schema for WMC 225.
// Production: set DATABASE_URL (pooled) and DIRECT_URL (direct) to your Postgres provider.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  owner
  kasir
}

enum ItemCategory {
  jasa
  sparepart
}

enum PaymentMethod {
  tunai
  transfer
  qris
}

enum TransactionStatus {
  selesai
  batal
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  username        String?          @unique
  passwordHash    String           @map("password_hash")
  role            UserRole
  createdAt       DateTime         @default(now()) @map("created_at")
  transactions    Transaction[]    @relation("TransactionCreator")
  payments        Payment[]        @relation("PaymentReceiver")
  expenses        Expense[]        @relation("ExpenseCreator")
  payables        Payable[]        @relation("PayableCreator")
  payablePayments PayablePayment[] @relation("PayablePaymentCreator")

  @@map("users")
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  vehicles     Vehicle[]
  transactions Transaction[]

  @@index([name])
  @@map("customers")
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  customerId   Int           @map("customer_id")
  plateNumber  String        @map("plate_number")
  brand        String
  model        String
  year         Int?
  color        String?
  odometer     Int?
  createdAt    DateTime      @default(now()) @map("created_at")
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([customerId])
  @@index([plateNumber])
  @@map("vehicles")
}

model Item {
  id               Int               @id @default(autoincrement())
  sku              String            @unique
  name             String
  category         ItemCategory
  unit             String            @default("pcs")
  price            Int
  cost             Int               @default(0)
  stock            Int               @default(0)
  minStock         Int               @default(0) @map("min_stock")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  transactionItems TransactionItem[]

  @@index([category])
  @@map("items")
}

model Transaction {
  id           String            @id @default(uuid())
  invoiceNo    String            @unique @map("invoice_no")
  customerId   Int               @map("customer_id")
  vehicleId    Int?              @map("vehicle_id")
  mechanic     String?
  subtotal     Int
  discount     Int               @default(0)
  total        Int
  businessDate DateTime          @map("business_date") @db.Date
  dueDate      DateTime?         @map("due_date") @db.Date
  notes        String?
  status       TransactionStatus @default(selesai)
  createdById  Int               @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  voidedAt     DateTime?         @map("voided_at")
  voidReason   String?           @map("void_reason")
  customer     Customer          @relation(fields: [customerId], references: [id])
  vehicle      Vehicle?          @relation(fields: [vehicleId], references: [id])
  createdBy    User              @relation("TransactionCreator", fields: [createdById], references: [id])
  items        TransactionItem[]
  payments     Payment[]

  @@index([businessDate])
  @@index([customerId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            Int          @id @default(autoincrement())
  transactionId String       @map("transaction_id")
  itemId        Int?         @map("item_id")
  name          String
  category      ItemCategory
  qty           Int
  unitPrice     Int          @map("unit_price")
  unitCost      Int          @default(0) @map("unit_cost")
  subtotal      Int
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item          Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@map("transaction_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  transactionId String        @map("transaction_id")
  amount        Int
  method        PaymentMethod
  notes         String?
  businessDate  DateTime      @map("business_date") @db.Date
  paidAt        DateTime      @default(now()) @map("paid_at")
  receivedById  Int           @map("received_by")
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receivedBy    User          @relation("PaymentReceiver", fields: [receivedById], references: [id])

  @@index([transactionId])
  @@index([businessDate])
  @@map("payments")
}

model Expense {
  id          Int      @id @default(autoincrement())
  expenseDate DateTime @map("expense_date") @db.Date
  category    String
  description String
  amount      Int
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   User     @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([expenseDate])
  @@map("expenses")
}

model Supplier {
  id            Int       @id @default(autoincrement())
  name          String
  contactPerson String?   @map("contact_person")
  phone         String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  payables      Payable[]

  @@map("suppliers")
}

model Payable {
  id           Int              @id @default(autoincrement())
  supplierId   Int              @map("supplier_id")
  referenceNo  String?          @map("reference_no")
  description  String
  amount       Int
  businessDate DateTime         @map("business_date") @db.Date
  dueDate      DateTime?        @map("due_date") @db.Date
  createdAt    DateTime         @default(now()) @map("created_at")
  createdById  Int              @map("created_by")
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  createdBy    User             @relation("PayableCreator", fields: [createdById], references: [id])
  payments     PayablePayment[]

  @@index([dueDate])
  @@map("payables")
}

model PayablePayment {
  id           Int           @id @default(autoincrement())
  payableId    Int           @map("payable_id")
  amount       Int
  method       PaymentMethod
  notes        String?
  businessDate DateTime      @map("business_date") @db.Date
  paidAt       DateTime      @default(now()) @map("paid_at")
  paidById     Int           @map("paid_by")
  payable      Payable       @relation(fields: [payableId], references: [id], onDelete: Cascade)
  paidBy       User          @relation("PayablePaymentCreator", fields: [paidById], references: [id])

  @@index([payableId])
  @@map("payable_payments")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}
